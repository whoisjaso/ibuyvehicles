# Buy desk
DESK_PASSCODE=            # Mark's passcode for /desk (6+ characters)
DESK_SESSION_SECRET=      # 32+ random characters: openssl rand -base64 48
SUPABASE_URL=             # Mark's own Supabase project
SUPABASE_SERVICE_ROLE_KEY=
BUSINESS_LEGAL_NAME=      # as on the bill of sale, e.g. the LLC name
BUSINESS_SIGNER_NAME=     # Mark's full legal name

# Lead alerts (pick one; the desk receives every lead either way). With neither, leads print to the server log.
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_TO_EMAIL=mark@ibuyvehicles.com
LEAD_FROM_EMAIL=

# Optional: AI review of the instant estimate. Without it the rules engine answers alone.
# Optional: Meta pixel for ad tracking (NEXT_PUBLIC_META_PIXEL_ID)
ANTHROPIC_API_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
